{
  "name": "@loureirodev/openspec-ui",
  "version": "0.3.0",
  "description": "A read-only dashboard for browsing OpenSpec changes, archives and specs.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/loureirodev/openspec-ui.git"
  },
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "openspec-ui": "bin/openspec-ui.js"
  },
  "files": [
    "bin",
    "dist"
  ],
  "packageManager": "pnpm@11.1.1",
  "scripts": {
    "lint": "biome ci .",
    "format": "biome check --write .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "build:client": "vite build",
    "build:server": "tsc -p tsconfig.build.json",
    "build": "pnpm clean && pnpm build:client && pnpm build:server",
    "start": "node bin/openspec-ui.js",
    "dev": "pnpm run --parallel \"/^dev:/\"",
    "dev:client": "vite",
    "dev:server": "pnpm build:server && node --watch dist/server/main.js --no-open --port 4321"
  },
  "dependencies": {
    "@hono/node-server": "^2.0.8",
    "@tanstack/react-query": "^5.101.2",
    "cross-spawn": "^7.0.6",
    "highlight.js": "^11.11.1",
    "hono": "^4.12.28",
    "open": "^11.0.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-markdown": "^10.1.0",
    "react-router": "^8.2.0",
    "rehype-highlight": "^7.0.2",
    "remark-frontmatter": "^5.0.0",
    "remark-gfm": "^4.0.1",
    "semver": "^7.8.5",
    "unist-util-visit": "^5.1.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.3",
    "@fission-ai/openspec": "^1.6.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/cross-spawn": "^6.0.6",
    "@types/mdast": "^4.0.4",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/semver": "^7.7.1",
    "@vitejs/plugin-react": "^6.0.3",
    "jsdom": "^29.1.1",
    "mdast-util-to-hast": "^13.2.1",
    "react-doctor": "^0.7.6",
    "typescript": "^7",
    "unified": "^11.0.5",
    "vite": "^8.1.4",
    "vitest": "^4.1.10"
  }
}
